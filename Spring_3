-- Ejercicio 2--
CREATE VIEW InformeTecnico AS
SELECT 
t.id AS "ID de la transaction",
u.name AS "Nombre del usario/a",
u.surname AS "Apellido del usario/a",
cc.iban AS "IBAN de la tarjeta de credito",
c.company_name AS "Nombre de la compania"
FROM 
transaction t 
JOIN 
   user u ON t.user_id=u.id
JOIN
   credit_card cc ON t.credit_card_id= cc.id
JOIN
   company c ON t.company_id=c.id
   ORDER BY t.id DESC;
   
   
   
SELECT*FROM InformeTecnico;



